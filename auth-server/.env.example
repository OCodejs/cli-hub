# Copy to .env locally. Never commit .env or real credentials.
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
DATABASE_URL=postgresql://ocode:change-me@localhost:5432/ocode_auth
DATABASE_SSL=false
# GitHub OAuth App callback: http://localhost:8787/auth/github/callback
GITHUB_CLIENT_ID=replace-with-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-oauth-app-client-secret
# Generate: openssl rand -base64 32 (must decode to exactly 32 bytes)
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=168
BODY_LIMIT=16kb
